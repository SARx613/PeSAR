# ============================================================
# SARgentine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ----- Mobile App (Expo) -----
# URL of your deployed Vercel backend (no trailing slash)
EXPO_PUBLIC_BACKEND_URL=https://your-app.vercel.app

# Your EAS project ID (run: eas init, then find it in eas.json or expo.dev)
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ----- Vercel Backend (set ONLY in Vercel Dashboard > Project > Settings > Environment Variables) -----
# These NEVER go in the app — they live server-side on Vercel only.
#
# Get these from: https://upstash.com → Create Redis Database → REST API
# UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXXXXxxxxxxxx
#
# A random secret to protect /api/scrape-rate from unauthorized calls.
# Generate one with: openssl rand -hex 32
# Set the SAME value in: Vercel env vars AND GitHub repo secrets (Settings → Secrets → Actions)
# CRON_SECRET=your_random_secret_here
